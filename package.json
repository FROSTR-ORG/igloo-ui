{
  "name": "igloo-ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=1 rm -rf dist && BROWSERSLIST_IGNORE_OLD_DATA=1 node ./scripts/build.mjs && BROWSERSLIST_IGNORE_OLD_DATA=1 node ./node_modules/typescript/bin/tsc -p tsconfig.json --emitDeclarationOnly && BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c ./tailwind.config.js -i ./src/styles.css -o ./dist/styles.css",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001777",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
